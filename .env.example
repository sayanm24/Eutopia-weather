# Copy to .env and fill in. Never commit .env.
# Keys are injected server-side by the proxy (vite dev server / server/index.js),
# so they never reach the browser bundle. Do NOT prefix them with VITE_.
OPENWEATHER_API_KEY=
# Optional. When set, WeatherAPI.com becomes the primary provider (search, current, forecast).
# Restart the dev server / rebuild after changing it.
WEATHERAPI_KEY=

# Port for the production server (npm run build && npm start)
PORT=8787
